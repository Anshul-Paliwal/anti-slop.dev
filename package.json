{
  "name": "anti-slop-dev",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "frontend",
    "vscode-extension"
  ],
  "scripts": {
    "build": "npm run build -w @anti-slop/shared && npm run build -w @anti-slop/npm-package",
    "test": "npm run test -w @anti-slop/npm-package",
    "dev:frontend": "npm run dev -w @anti-slop/frontend",
    "build:vscode": "npm run package -w anti-slop-vscode"
  }
}
