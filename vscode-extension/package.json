{
  "name": "anti-slop-vscode",
  "displayName": "Anti-Slop Code Analyzer",
  "publisher": "anti-slop",
  "description": "Analyze codebases for AI-generated patterns with Gemini Flash 2.0 (BYOK)",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Linters",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "anti-slop.analyzeWorkspace",
        "title": "Anti-Slop: Analyze Entire Workspace"
      },
      {
        "command": "anti-slop.analyzeFile",
        "title": "Anti-Slop: Analyze Current File"
      },
      {
        "command": "anti-slop.analyzeFileUnified",
        "title": "Anti-Slop: Quick Slop Scan (Free Tier Unified)"
      },
      {
        "command": "anti-slop.analyzeFileWithSkills",
        "title": "Anti-Slop: Analyze with All Skills"
      },
      {
        "command": "anti-slop.selectSkills",
        "title": "Anti-Slop: Select Skills and Analyze"
      },
      {
        "command": "anti-slop.analyzeByCategory",
        "title": "Anti-Slop: Analyze by Category"
      },
      {
        "command": "anti-slop.listSkills",
        "title": "Anti-Slop: List Available Skills"
      },
      {
        "command": "anti-slop.configureApiKey",
        "title": "Anti-Slop: Configure Gemini API Key"
      },
      {
        "command": "anti-slop.getFreeApiKey",
        "title": "Anti-Slop: Get Free Gemini API Key (Google AI Studio)"
      },
      {
        "command": "anti-slop.testApiKey",
        "title": "Anti-Slop: Test Gemini API Key"
      },
      {
        "command": "anti-slop.clearResults",
        "title": "Anti-Slop: Clear Results & Diagnostics"
      },
      {
        "command": "anti-slop.showReport",
        "title": "Anti-Slop: Show Analysis Report"
      },
      {
        "command": "anti-slop.createPipeline",
        "title": "Anti-Slop: Create Analysis Pipeline"
      }
    ],
    "configuration": {
      "title": "Anti-Slop",
      "properties": {
        "antiSlop.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Your Gemini API key (BYOK from Google AI Studio)",
          "order": 1
        },
        "antiSlop.model": {
          "type": "string",
          "default": "gemini-3.8-flash",
          "enum": [
            "gemini-3.8-flash",
            "gemini-3.8-pro",
            "gemini-3.0-flash",
            "gemini-2.5-flash"
          ],
          "description": "Gemini model to use for analysis (gemini-3.8-flash recommended)",
          "order": 2
        },
        "antiSlop.useUnifiedScan": {
          "type": "boolean",
          "default": true,
          "description": "Use single-request unified analysis to conserve Gemini Free Tier 15 RPM quota",
          "order": 3
        },
        "antiSlop.analysisThreshold": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence threshold for flagging vibe-coded patterns (0-1)",
          "order": 4
        },
        "antiSlop.enableInlineDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Show AI slop warnings and errors directly in the VS Code editor & Problems panel",
          "order": 5
        },
        "antiSlop.enableLocalHeuristics": {
          "type": "boolean",
          "default": true,
          "description": "Run local AST heuristic checks (console.log, debugger, empty catch) with 0 API calls",
          "order": 6
        },
        "antiSlop.autoAnalyzeOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically analyze files on save",
          "order": 7
        },
        "antiSlop.excludePatterns": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/dist/**",
            "**/build/**",
            "**/.git/**"
          ],
          "description": "Glob patterns to exclude from analysis",
          "order": 8
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "anti-slop",
          "title": "Anti-Slop",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "anti-slop": [
        {
          "id": "antiSlopResults",
          "name": "Analysis Results"
        },
        {
          "id": "antiSlopPipelines",
          "name": "Pipelines"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "npm run compile"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@google/generative-ai": "^0.24.1"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
